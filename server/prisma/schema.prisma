/// ─────────────────────────────────────────────────────────────────────────────
/// Gap closures, October 2026. One block per row in docs/gap-analysis.md.
/// ─────────────────────────────────────────────────────────────────────────────

/// PER-ANIMAL HEALTH AND DISEASE LOG (gap-analysis row 5).
///
/// Until now a `Vaccination` could point at an Animal but nothing else could,
/// so a keeper with tagged cattle could record that an animal was vaccinated and
/// then had nowhere to write "she limped on Tuesday". Health was effectively
/// flock-level with one exception bolted on.
///
/// This model makes the animal the record: a row is one thing that HAPPENED to
/// one animal (or, when animalId is null, to a whole flock). Flock-level entries
/// stay supported because that is how most Kenyan keepers actually work — the
/// point is that the animal-level option exists, not that we force it.
model HealthRecord {
  id       Int     @id @default(autoincrement())
  farmId   Int     @map("farm_id")
  flockId  Int?    @map("flock_id")
  /// The tagged animal this concerns. Null = flock-level entry.
  animalId Int?    @map("animal_id")

  /// observation | treatment | diagnosis | death | check
  type      String   @default("observation")
  /// What the keeper calls it, in their words. We never normalise a farmer's
  /// vocabulary into a controlled list — "foot rot", "footrot" and "foot-rot"
  /// are one disease to them and a search must find all three.
  condition String
  /// What was done: drug, dose, advice, quarantine.
  action    String?
  /// Vet who attended, if any. Free text: many rural keepers have no vet on call.
  vetName   String?  @map("vet_name")

  observedAt DateTime  @default(now()) @map("observed_at") @db.Date
  resolvedAt DateTime? @map("resolved_at") @db.Date
  cost       Decimal?  @db.Decimal(12, 2)
  /// A6: the last day this animal's milk or eggs may not be sold. A treated cow
  /// sold into the co-op inside the withdrawal window is a food-safety problem
  /// AND a payment problem (the milk is rejected, or worse, it is not). Stored
  /// as the date the farmer was given, never computed from a guessed drug
  /// half-life — the vet's or the label's number is the authority, not ours.
  withdrawalUntil DateTime? @map("withdrawal_until") @db.Date
  /// What the withdrawal applies to — "milk 3 days", "eggs 7 days". Free text
  /// because that is how a drug label and a rural vet both state it.
  withdrawalNote String? @map("withdrawal_note")
  notes      String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  farm   Farm    @relation(fields: [farmId], references: [id], onDelete: Cascade)
  flock  Flock?  @relation(fields: [flockId], references: [id], onDelete: SetNull)
  animal Animal? @relation(fields: [animalId], references: [id], onDelete: SetNull)

  @@index([farmId, observedAt])
  @@index([animalId])
  @@index([flockId])
  @@index([farmId, condition])
  @@map("health_records")
}

/// INDEX-INSURANCE POLICY REGISTER (gap-analysis row 13).
///
/// Wangari records the EVIDENCE a farmer needs to claim; it never prices risk,
/// never underwrites and never estimates a payout. That boundary is the design:
/// a regulator would read a payout calculator as insurance business, and a
/// farmer whose claim was recorded wrongly here would have no recourse against
/// us. So this is a register, not a product.
///
/// The ANITRAC link is what makes it worth anything: a policy naming a flock
/// is verifiable only if that flock's animals carry tags. A policy over zero
/// tagged animals is a piece of paper, and the UI says so out loud.
model InsurancePolicy {
  id      Int    @id @default(autoincrement())
  farmId  Int    @map("farm_id")
  flockId Int?   @map("flock_id")

  insurer      String
  policyNumber String  @map("policy_number")
  /// index | livestock | crop | comprehensive
  productType  String  @default("index") @map("product_type")
  /// Unit count the policy is written against (head, trees, kg, trays).
  unitsCovered Int?    @map("units_covered")
  sumInsured   Decimal? @map("sum_insured") @db.Decimal(14, 2)
  premiumPaid  Decimal? @map("premium_paid") @db.Decimal(12, 2)

  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  /// active | expired | claimed | lapsed
  status    String   @default("active")

  /// For index cover: the rainfall/price trigger the contract pays on. Stored
  /// so the farmer can see WHAT would have to happen. We do not evaluate it.
  triggerMetric String?  @map("trigger_metric")
  triggerValue  Decimal? @map("trigger_value") @db.Decimal(12, 2)

  notes    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  farm  Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  flock Flock? @relation(fields: [flockId], references: [id], onDelete: SetNull)
  claims InsuranceClaim[]

  @@index([farmId, status])
  @@index([endDate])
  @@map("insurance_policies")
}

/// C5: what the insurer actually paid — which is NOT the farmer's loss.
///
/// Index insurance pays on a TRIGGER (rainfall, an area yield), not on what
/// happened on this farm. Those two numbers are routinely different in both
/// directions and the gap is where trust dies: a farmer told "you are covered"
/// who receives a third of the loss they measured stops believing any of it.
/// So this model keeps `measuredLossUnits` (their own count) and
/// `expectedAmount`/`receivedAmount` (what was promised and what arrived)
/// side by side and never computes one from the other.
model InsuranceClaim {
  id                Int       @id @default(autoincrement())
  farmId            Int       @map("farm_id")
  policyId          Int?      @map("policy_id")
  claimRef          String?   @map("claim_ref")
  incidentOn        DateTime  @map("incident_on") @db.Date
  /// drought | flood | pest | disease | fire | price | other
  eventType         String    @map("event_type")
  /// The farmer's own count of what they lost (head, kg, trees). Units are
  /// whatever the policy is written in — we do not normalise them.
  measuredLossUnits Int?      @map("measured_loss_units")
  expectedAmount    Decimal?  @map("expected_amount") @db.Decimal(12, 2)
  receivedAmount    Decimal?  @map("received_amount") @db.Decimal(12, 2)
  receivedOn        DateTime? @map("received_on") @db.Date
  status            String    @default("submitted") // submitted | approved | paid | rejected
  notes             String?
  createdBy         Int?      @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  farm   Farm             @relation(fields: [farmId], references: [id], onDelete: Cascade)
  policy InsurancePolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)

  @@index([farmId, incidentOn])
  @@map("insurance_claims")
}

/// B5: the fertiliser e-voucher, RECORDED rather than integrated.
///
/// The KIAMIS export already proves eligibility; this records what happened
/// after it. The value is not the voucher — it is that a subsidy must never be
/// counted as cash income. The farmer pays `farmerContribution` and the voucher
/// covers the rest, so keeping both means the real input cost stays visible
/// instead of a government transfer quietly understating what a crop cost.
///
/// `cropId` and `plotId` are plain integers with NO relation on purpose: a
/// voucher is redeemed at a dealer against an entitlement derived from declared
/// acreage, and the record has to survive the crop being deleted or the plot
/// renamed. A lookup at read time is cheap; a ledger row removed by a cascade is
/// data loss.
model InputVoucher {
  id                 Int      @id @default(autoincrement())
  farmId             Int      @map("farm_id")
  /// nfsp | kcep_cral | county | other — free text, because programmes change
  /// name between seasons and a hard-coded list would block next season.
  program            String   @default("nfsp")
  dealer             String?
  /// The face value the programme covered. NOT income.
  voucherValue       Decimal  @map("voucher_value") @db.Decimal(12, 2)
  /// What the farmer actually paid in cash. THIS is the input cost.
  farmerContribution Decimal  @default(0) @map("farmer_contribution") @db.Decimal(12, 2)
  quantityKg         Decimal? @map("quantity_kg") @db.Decimal(10, 2)
  inputName          String?  @map("input_name")
  redeemedOn         DateTime @map("redeemed_on") @db.Date
  cropId             Int?     @map("crop_id")
  plotId             Int?     @map("plot_id")
  notes              String?
  createdBy          Int?     @map("created_by")
  createdAt          DateTime @default(now()) @map("created_at")

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId, redeemedOn])
  @@index([farmId, cropId])
  @@map("input_vouchers")
}

/// C7: the chama / table-banking ledger.
///
/// `CoopGroup` covers membership, join codes and expiry — not money. A chama is
/// a different thing from a co-operative: members contribute on a fixed day,
/// borrow from the pot, and repay with interest, and the statement a member
/// wants is "what have I put in and what do I still owe".
///
/// One flat table of SIGNED-BY-TYPE movements rather than three tables, because
/// a chama book records every one of them on the same page in date order and a
/// member's balance is one running sum. A row here is never a loan product and
/// never accrues interest on its own — `lib/savings-ledger.ts` derives the
/// member position from the entries exactly as written.
model SavingsEntry {
  id          Int      @id @default(autoincrement())
  farmId      Int      @map("farm_id")
  /// Ties to CoopGroup when the group is one in the app; plain int and optional,
  /// because most chamas are not and must still be recordable.
  coopGroupId Int?     @map("coop_group_id")
  groupName   String   @map("group_name")
  memberName  String   @map("member_name")
  /// contribution | withdrawal | loan_out | repayment
  entryType   String   @map("entry_type")
  amount      Decimal  @db.Decimal(12, 2)
  occurredOn  DateTime @map("occurred_on") @db.Date
  counterparty String?
  notes       String?
  createdBy   Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId, occurredOn])
  @@index([farmId, groupName])
  @@map("savings_entries")
}

/// C4: the farmer's own plan, which is what turns the ledger into a forecast.
///
/// A budget is not a ledger and this is not a second place money is recorded —
/// no row here is ever counted as spent or received. It exists so the forward
/// view has something to look forward TO: school fees in December, a bag of
/// fertiliser in March. `lib/cash-flow.ts` combines these with the money the
/// farmer is already owed, their loan instalments, and their own trailing costs,
/// and labels every projected figure as a projection.
model BudgetItem {
  id        Int      @id @default(autoincrement())
  farmId    Int      @map("farm_id")
  label     String
  /// inflow | outflow — one field rather than a signed amount, because a farmer
  /// entering "-4000" for a cost is a support call waiting to happen.
  direction String   @default("outflow")
  amount    Decimal  @db.Decimal(12, 2)
  dueOn     DateTime @map("due_on") @db.Date
  category  String?
  /// once | weekly | monthly | seasonal — how a repeated plan item recurs.
  recurring String?
  notes     String?
  createdBy Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId, dueOn])
  @@map("budget_items")
}

/// MARKET PRICE BENCHMARK (gap-analysis row 14).
///
/// Farmers routinely sell below the going rate because nobody told them the
/// going rate. This is a reference table, NOT a price feed and NOT an exchange:
/// entries are seeded by us or entered by the farmer from the offer they were
/// given, and every price states its region and date so it can be judged.
///
/// Deliberately region-scoped. A national average would tell a farmer in Nakuru
/// that a "good" price is one they can never actually get, which is worse than
/// no benchmark — it teaches them to ignore the number.
model MarketPrice {
  id        Int      @id @default(autoincrement())
  /// Normalised against one vocabulary so milk, eggs and beef each compare.
  /// See lib/market-price.ts for the unit contract.
  commodity String
  unit      String // litre | tray | kg | head | bag
  /// Null = national default, seeded by us.
  region       String?
  priceKes     Decimal  @map("price_kes") @db.Decimal(10, 2)
  /// e.g. "Nakuru dairy cooperative", "Kisumu market", "Ministry indicative"
  source       String?
  effectiveDate DateTime @map("effective_date") @db.Date
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([commodity, region, effectiveDate])
  @@map("market_prices")
}

/// COLD CHAIN READING (gap-analysis row 15).
///
/// PostHarvestBatch stored `storageTempC` — one number, set once, never checked
/// again. An avocado export fails on an excursion nobody measured, so a single
/// "final" temperature is not evidence of anything: the export buyer wants the
/// CURVE.
///
/// Append-only log of readings. Derived at read time: hours above threshold,
/// time-to-cool from harvest, and whether the chain actually broke.
model ColdChainEvent {
  id         Int      @id @default(autoincrement())
  farmId     Int      @map("farm_id")
  batchId    Int      @map("batch_id")
  recordedAt DateTime @default(now()) @map("recorded_at")
  tempC      Decimal  @map("temp_c") @db.Decimal(5, 2)
  /// Where in the chain the reading was taken: field | truck | coldroom | store
  stage      String   @default("coldroom")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  farm  Farm             @relation(fields: [farmId], references: [id], onDelete: Cascade)
  batch PostHarvestBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, recordedAt])
  @@map("cold_chain_events")
}

/// A COOPERATIVE, SACCO OR GROUP OF FARMERS (gap-analysis rows 11 + 17).
///
/// One user = one farm is the model that worked; this is the wrapper that lets a
/// chairperson see a group WITHOUT any member's private finances leaving their
/// farm. That constraint is enforced in the data shape, not the UI:
/// `CoopMembership` points at a Farm, and no member-scoped table is reachable
/// from a Group at all. There is no code path by which a chair reads a member's
/// deliveries, sales or credit, because the aggregate reads counts and sums
/// only, never rows. See lib/coop-aggregate.ts.
model CoopGroup {
  id          Int      @id @default(autoincrement())
  name        String
  /// The chair is a User, not a Farm: a chair who owns no animals still runs
  /// the group, which is the normal shape of a Kenyan SACCO secretary.
  chairUserId Int      @map("chair_user_id")
  county      String?
  /// Human-readable join code, e.g. "KIUMBO-4821". See lib/coop-code.ts.
  joinCode    String   @unique @map("join_code")
  /// When the join code stops working, set by the chair. NULL means the code
  /// stays open — which is why this is nullable rather than defaulted: a
  /// permanent code is a legitimate choice, and a default would silently
  /// expire every existing group's code the day this shipped.
  joinCodeExpiresAt DateTime? @map("join_code_expires_at")
  /// active | dissolved
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  chair       User             @relation("CoopChair", fields: [chairUserId], references: [id], onDelete: Cascade)
  memberships CoopMembership[]
  invites     CoopInvite[]

  @@index([chairUserId])
  @@map("coop_groups")
}

/// A farm inside a co-op. Deliberately a membership row, NOT a foreign key that
/// grants visibility: holding one says "this farm belongs to this group" and
/// grants access to the group's aggregate numbers. Nothing else.
model CoopMembership {
  id       Int      @id @default(autoincrement())
  groupId  Int      @map("group_id")
  farmId   Int      @map("farm_id")
  /// chair | secretary | member
  role     String   @default("member")
  joinedAt DateTime @default(now()) @map("joined_at")

  group CoopGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  farm  Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@unique([groupId, farmId])
  @@index([groupId])
  @@map("coop_memberships")
}

/// A pending invitation to join a co-op, issued against a phone number.
///
/// Bulk onboarding (row 17) must work without the chair knowing anyone's email,
/// and must reach farmers who are not in the app yet. So the invite targets a
/// PHONE and a code: the farmer enters it at signup. This is what makes co-op
/// onboarding a solved problem rather than a dashboard over zeros.
model CoopInvite {
  id          Int      @id @default(autoincrement())
  groupId     Int      @map("group_id")
  /// The farmer being invited. Normalised (see lib/coop-code.ts).
  phone       String
  /// 6-character human-readable code, unique per invite.
  code        String   @unique
  invitedById Int      @map("invited_by_id")
  /// pending | accepted | revoked | expired
  status      String   @default("pending")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  acceptedAt  DateTime? @map("accepted_at")

  group     CoopGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("CoopInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([groupId, status])
  @@index([phone])
  @@map("coop_invites")
}

/// A model the super-admin has registered for Wangari's assistant.
///
/// Exactly one row may hold role "primary" and one "fallback" at a time; that
/// invariant is enforced by partial unique indexes in the migration rather than
/// by application code, because two live primaries is the failure mode that
/// silently halves throughput and is invisible until a farmer waits twice as
/// long as everyone else.
///
/// `probeState` is why a model cannot simply be typed in and switched on: a
/// model that cannot chain two tool calls looks fine until it leaves the screen
/// quiet halfway through recording a sale. The super-admin UI refuses to
/// activate anything that has not passed, and `probeState` records what the
/// probe actually said so a bad activation is traceable afterwards.
model AiModel {
  id        Int      @id @default(autoincrement())
  provider  String
  model     String
  label     String?
  role      String   @default("candidate") // "primary" | "fallback" | "candidate"

  /// Encrypted at rest with AES-256-GCM; the plaintext never touches the DB.
  /// Nullable because a provider already configured in .env needs no row key,
  /// and forcing one would put a secret in the database for no gain.
  apiKeyEnc String?  @map("api_key_enc")
  baseUrl   String?  @map("base_url")

  /// USD per 1M tokens, as published by the provider. Null on providers that
  /// publish no per-model pricing (UnoRouter), which is why the roster filter
  /// reads the ":free" id suffix instead — see lib/free-model-roster.ts.
  costInPerM  Float? @map("cost_in_per_m")
  costOutPerM Float? @map("cost_out_per_m")
  isFree      Boolean @default(true) @map("is_free")

  contextLength Int? @map("context_length")

  probeState String   @default("untested") @map("probe_state") // "untested" | "passing" | "failing" | "error"
  probeReason String? @map("probe_reason")
  probedAt    DateTime? @map("probed_at")
  probeMs     Int?     @map("probe_ms")

  /// Rolling health from real farmer traffic, so the UI can show a model that
  /// passes its probe but is slow or flapping in production.
  lastLatencyMs Int?      @map("last_latency_ms")
  successCount  Int       @default(0) @map("success_count")
  failureCount  Int       @default(0) @map("failure_count")
  lastUsedAt    DateTime? @map("last_used_at")

  enabled   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([provider, model])
  @@index([role])
  @@map("ai_models")
}

/// Operator-set AI knobs that are not per-model: search cap, rate-limit
/// window, step ceiling. One row; anything NULL means "use the code default",
/// which is what keeps a partially-filled table from changing behaviour.
model AiSettings {
  id                Int      @id @default(1)
  searchesPerTurn   Int?     @map("searches_per_turn")
  rateLimitWindowMs Int?     @map("rate_limit_window_ms")
  maxSteps          Int?     @map("max_steps")
  /// When true, a paid model may be activated. The default of FALSE is the
  /// whole point: this is a farm SaaS with a $0 balance, and the cheapest
  /// accident here is a real invoice.
  allowPaidModels   Boolean  @default(false) @map("allow_paid_models")
  updatedBy         Int?     @map("updated_by")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("ai_settings")
}

/// ─────────────────────────────────────────────────────────────────────────────
/// IP access control (System Health).
///
/// The server is on the internet and nothing could see what was knocking.
/// A range, not just a single address, because a scan comes from a /24 and
/// rotates inside it — storing only the exact address an attacker happened to
/// use would be security theatre.
///
/// `allow` beats `block` when both match. See lib/ip-rules.ts for why that
/// direction was chosen: the failure mode of getting it wrong is a farmer
/// locked out of the app they pay for.
///
/// The hit counter is on the row rather than in a log table because the only
/// question asked of it is "is this rule earning its keep", which one counter
/// answers without a query per request.
model IpRule {
  id        Int    @id @default(autoincrement())

  /// Exact address ("203.0.113.7"), CIDR ("203.0.113.0/24") or wildcard
  /// ("203.0.113.*", "203.0.*.*"). Validated in lib/ip-rules.ts, which is the
  /// only place that decides what a pattern means.
  pattern   String
  action    String @default("block") // "block" | "allow"

  /// Why this rule exists, in the operator's words. The note is what makes the
  /// list reviewable six months later, when nobody remembers adding it.
  note      String?

  /// Which super-admin added it, so the audit trail names a person and not an
  /// anonymous action.
  addedBy   String? @map("added_by")

  hitCount    Int       @default(0) @map("hit_count")
  lastHitAt   DateTime? @map("last_hit_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([action])
  @@map("ip_rules")
}
