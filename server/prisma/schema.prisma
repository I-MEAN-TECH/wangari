generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int       @id @default(autoincrement())
  name             String
  email            String    @unique
  phone            String?   @unique
  password         String?
  googleId         String?   @unique @map("google_id")
  avatar           String?
  role             String    @default("farm_owner")
  profileComplete  Boolean   @default(false) @map("profile_complete")
  emailVerified    DateTime? @map("email_verified")
  /// Hashed 4-digit PIN used for phone-only sign-in (no email, no password).
  /// Null means this account has never set one. See lib/phone-pin.ts.
  phonePin         String?   @map("phone_pin")
  /// When the phone was proven to belong to this user. A phone-only account
  /// with a null phoneVerifiedAt has NOT proven ownership of its number.
  phoneVerifiedAt  DateTime? @map("phone_verified_at")
  /// How this account signs in: email_password | phone_pin | google
  authMethod       String?   @map("auth_method")
  /// KIAMIS identity — the farmer's national ID number, digits only.
  /// NULL = not given. Sensitive: ordinary profile reads return only a masked
  /// hint; the full number leaves the server solely through the owner's own
  /// KIAMIS export (routes/kiamis.ts).
  nationalId       String?   @map("national_id")
  trialStartsAt    DateTime? @map("trial_starts_at")
  trialEndsAt      DateTime? @map("trial_ends_at")
  selectedHubs     String?   @map("selected_hubs")
  resetToken       String?   @map("reset_token")
  resetTokenExpiry DateTime? @map("reset_token_expiry")
  tokenVersion     Int       @default(0) @map("token_version")
  totpSecret       String?   @map("totp_secret")
  totpEnabledAt    DateTime? @map("totp_enabled_at")
  lastMfaNudgedAt  DateTime? @map("last_mfa_nudged_at")
  recoveryCodes    String?   @map("recovery_codes") // JSON array of bcrypt-hashed codes
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  farms         FarmMember[]
  ownedFarms    Farm[]
  flocks        Flock[]
  transactions  Transaction[]
  sales         Sale[]
  workers       Worker[]
  auditLogs     AuditLog[]
  tickets       Ticket[]
  feedback      Feedback[]
  crops         Crop[]
  plots         Plot[]
  farmLoans     FarmLoan[]
  loanRepayments LoanRepayment[]
  verifications VerificationCode[]
  subscriptions Subscription[]
  activationEvents ActivationEvent[]
  ownedCoops       CoopGroup[] @relation("CoopChair")
  coopInvitesSent  CoopInvite[] @relation("CoopInviter")

  @@map("users")
}

model ActivationEvent {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  /// signup | onboarding_completed | first_record | active
  stage     String
  /// UTC calendar day, YYYY-MM-DD. One row per user per stage per day, so a
  /// farmer who opens the app 40 times counts as one day of returning — not 40.
  day       String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, stage, day])
  @@index([stage])
  @@map("activation_events")
}

model VerificationCode {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  code      String
  purpose   String    @default("email_verification")
  attempts  Int       @default(0) // failed verification tries; code burns at 5
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_codes")
}

// Failed PIN attempts, keyed by phone number.
//
// This has to live in the database rather than a Map in the route module. The
// API runs under `pm2` in cluster mode with two workers, so an in-process
// counter is split across two disjoint maps: consecutive attempts on one account
// land on different workers, neither ever reaches five, and the lockout that the
// 4-digit PIN depends on silently never fires. A restart wipes it too. In the DB
// it is one row every worker reads and writes.
model PhonePinAttempt {
  phone     String    @id
  count     Int       @default(0)
  lockedUntil DateTime? @map("locked_until")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("phone_pin_attempts")
}

// Pricing source of truth — seeded from code once, editable in DB afterwards.
// amount is in Pesewas (Paystack minor unit) to avoid float money.
model Plan {
  id          String  @id
  name        String
  description String?
  amount      Int
  days        Int
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  promoCodes PromoCode[]

  @@map("plans")
}

// Editable website content (pricing page copy, contact page details, FAQs).
// JSON blob per page — the admin Website module writes it, public pages read
// it. Never delete rows: history is the audit trail via admin audit log.
model SiteContent {
  page      String   @id
  data      Json
  updatedBy Int?     @map("updated_by")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("site_content")
}

// ─── Delivery ledger ────────────────────────────────────────
// The farmer's dispute-proof record of produce delivered to a
// buyer (dairy/co-op/factory/broker) with money expected back.
// commodity: milk | coffee_cherry | maize | other
model Delivery {
  id          Int      @id @default(autoincrement())
  farmId      Int      @map("farm_id")
  docCode     String?  @map("doc_code")
  date        DateTime @db.Date
  commodity   String
  quantity    Decimal  @db.Decimal(12, 2) // litres / kg
  unit        String   @default("litres")
  buyer       String // "Brookside", "Githunguri Factory", broker name
  receiptRef  String?  @map("receipt_ref") // slip/receipt number from the buyer
  unitPrice   Decimal? @map("unit_price") @db.Decimal(12, 2) // KES per unit, if known
  expectedPay Decimal? @map("expected_pay") @db.Decimal(12, 2) // gross expected for this delivery
  // Milk-quality test results exactly as the co-op slip shows them (QBMP:
  // fat is priced per kg delivered; measured added water is deducted from the
  // volume paid). Storage only — band pricing is the co-op's term, not ours.
  fatPct        Decimal? @map("fat_pct") @db.Decimal(5, 2)
  snfPct        Decimal? @map("snf_pct") @db.Decimal(5, 2)
  density       Decimal? @map("density") @db.Decimal(5, 3)
  addedWaterPct Decimal? @map("added_water_pct") @db.Decimal(5, 2)
  /// Total plate count (cfu/ml) where the co-op reports it.
  tpc           Int?     @map("tpc")
  /// Who ran the test — the co-op's own label, so a disputed result is checkable.
  gradedBy      String?  @map("graded_by")
  /// When the buyer promised to pay. Null = no promise, so no arrears clock:
  /// we never make a delivery "late" against a date that was never given.
  payBy       DateTime? @map("pay_by") @db.Date
  status      String   @default("pending") // pending | paid | disputed
  paidAmount  Decimal? @map("paid_amount") @db.Decimal(12, 2)
  paidAt      DateTime? @map("paid_at")
  notes       String?
  // Egg / produce quality grading
  crackedCount Int?     @map("cracked_count")
  dirtyCount   Int?     @map("dirty_count")
  gradedCount  Int?     @map("graded_count")
  // Payment terms & expected payout date (ERPNext gap #6)
  paymentTerms        String?   @map("payment_terms")
  expectedPaymentDate DateTime? @map("expected_payment_date") @db.Date
  // Optional buyer relation
  customerId   Int?     @map("customer_id")
  createdBy    Int?     @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  farm       Farm                @relation(fields: [farmId], references: [id])
  customer   Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deductions DeliveryDeduction[]

  @@index([farmId, date])
  @@index([farmId, payBy])
  @@index([farmId, commodity])
  @@index([farmId, customerId])
  @@map("deliveries")
}

// Check-off deductions taken by the buyer from the payout
// (AI services, agrovet input credit, transport levy, etc.)
model DeliveryDeduction {
  id         Int     @id @default(autoincrement())
  deliveryId Int     @map("delivery_id")
  label      String // "AI service", "Agrovet credit", "Transport"
  amount     Decimal @db.Decimal(12, 2)
  // Who the deduction is deducted FOR — the co-op, an agrovet, or the
  // farmer's own SACCO loan being collected at source. The statement groups
  // by this so "what the co-op kept" and "what paid my loan" come apart.
  creditor   String?
  /// When this deduction is the co-op collecting a loan repayment at source,
  /// this points at the FarmLoan it pays down. Null = a plain deduction.
  farmLoanId Int?     @map("farm_loan_id")

  delivery   Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  farmLoan   FarmLoan? @relation(fields: [farmLoanId], references: [id])
  loanRepayments LoanRepayment[]

  @@map("delivery_deductions")
}

// C2: the farmer's OWN debt — money the farm owes a lender (SACCO, AFC, an
// agrovet for inputs, a chama). This is the opposite direction from `Credit`, which
// is money owed TO the farm by its customers. Wangari records the loan and
// every repayment; it never makes a credit decision — the lender does.
model FarmLoan {
  id                Int       @id @default(autoincrement())
  farmId            Int       @map("farm_id")
  lender            String // "Githunguri SACCO", "AFC", "Kilimo Biashara agrovet"
  loanType          String?   @map("loan_type") // sacco | afc | input_credit | personal | other
  principal         Decimal   @db.Decimal(12, 2) // KES borrowed
  interestRatePct  Decimal?  @map("interest_rate_pct") @db.Decimal(5, 2) // annual rate, if known
  disbursedAt       DateTime? @map("disbursed_at") @db.Date // when money/inputs arrived
  firstInstalmentDue DateTime? @map("first_instalment_due") @db.Date
  instalmentCount   Int?      @map("instalment_count") // total number of instalments
  instalmentAmount  Decimal?  @map("instalment_amount") @db.Decimal(12, 2)
  amountPaid        Decimal   @default(0) @map("amount_paid") @db.Decimal(12, 2) // sum of all repayments
  status            String    @default("active") // active | settled | defaulted
  notes             String?
  createdBy         Int?      @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  farm         Farm              @relation(fields: [farmId], references: [id])
  creator      User?             @relation(fields: [createdBy], references: [id])
  repayments   LoanRepayment[]
  deductions   DeliveryDeduction[]

  @@index([farmId, status])
  @@map("farm_loans")
}

// One repayment against a FarmLoan. A repayment can be cash/M-Pesa the farmer hands
// over, or a co-op deduction collected at source (then `deliveryDeductionId`
// links it). `amountPaid` on FarmLoan is the running sum of these rows.
model LoanRepayment {
  id                  Int       @id @default(autoincrement())
  farmLoanId          Int       @map("farm_loan_id")
  farmId              Int       @map("farm_id")
  amount              Decimal   @db.Decimal(12, 2)
  paidAt              DateTime  @map("paid_at") @db.Date
  source              String    @default("cash") // cash | mpesa | bank | deduction
  deliveryDeductionId Int?      @map("delivery_deduction_id")
  notes               String?
  createdBy           Int?      @map("created_by")
  createdAt           DateTime  @default(now()) @map("created_at")

  farmLoan          FarmLoan          @relation(fields: [farmLoanId], references: [id], onDelete: Cascade)
  farm              Farm            @relation(fields: [farmId], references: [id])
  deliveryDeduction DeliveryDeduction? @relation(fields: [deliveryDeductionId], references: [id])
  creator           User?           @relation(fields: [createdBy], references: [id])

  @@index([farmLoanId, paidAt])
  @@map("loan_repayments")
}

model Subscription {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  plan      String
  planName  String    @map("plan_name")
  amount    Decimal   @db.Decimal(12, 2)
  status    String    @default("active")
  reference String?
  startsAt  DateTime  @default(now()) @map("starts_at")
  expiresAt DateTime  @map("expires_at")
  renewedAt DateTime? @map("renewed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("subscriptions")
}

model Farm {
  id        Int      @id @default(autoincrement())
  name      String
  code      String?  @unique
  location  String?
  county    String?
  farmType  String?  @map("farm_type")
  ownerId   Int      @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")
  // When the farmer stated what they farm and claimed this farm in onboarding.
  // NOT back-filled for existing farms — see migrations/16_farm_claimed_at.
  claimedAt DateTime? @map("claimed_at")

  // ─── M1: the accountant layer ───
  // Farm size, because every per-unit metric (cost per egg, cost per litre,
  // cost per acre) needs a denominator, and KIAMIS derives subsidy quantities
  // from declared acreage. One nullable pair; existing farms keep NULL and are
  // never blocked. `areaUnit` is "acre" | "hectare".
  areaValue Decimal? @map("area_value") @db.Decimal(10, 2)
  areaUnit  String?  @map("area_unit")

  // ─── M2: the compliance spine groundwork ───
  // ANITRAC §18 premises/holding registration number, issued by the county.
  // NULL = not registered yet; nothing here blocks a farm from working.
  premisesRegNo String? @map("premises_reg_no")
  // Plot GPS — serves ANITRAC §18, KIAMIS geo-mapping and EUDR coffee
  // geo-traceability at once. Captured by the farmer tapping "use my
  // location", never typed (R1). Captured as a pair or not at all.
  latitude  Decimal? @map("latitude") @db.Decimal(10, 7)
  longitude Decimal? @map("longitude") @db.Decimal(10, 7)

  owner            User              @relation(fields: [ownerId], references: [id])
  members          FarmMember[]
  flocks           Flock[]
  transactions     Transaction[]
  inventory        Inventory[]
  announcements    Announcement[]
  customers        Customer[]
  sales            Sale[]
  workers          Worker[]
  deliveries       Delivery[]
  feedRecipes      FeedRecipe[]
  weatherCache     WeatherCache[]
  dailyProductions DailyProduction[]
  animalProduction AnimalProduction[]
  credits          Credit[]
  attendances      Attendance[]
  auditLogs        AuditLog[]
  settings         FarmSetting[]
  workerTasks      WorkerTask[]
  workerLogs       WorkerLog[]
  zktecoDevices    ZKTecoDevice[]
  zktecoLogs       ZKTecoLog[]
  breeding         Breeding[]
  crops            Crop[]
  plots            Plot[]
  farmLoans        FarmLoan[]
  loanRepayments   LoanRepayment[]
  cropHarvests     CropHarvest[]
  cropHealth       CropHealth[]
  cropApplications CropApplication[]
  postHarvestBatches PostHarvestBatch[]
  soilTests        SoilTest[]
  invoices         Invoice[]
  quotes           Quote[]
  newsSends        NewsArticleSend[]
  animals          Animal[]
  flockBatches     FlockBatch[]
  hives            Hive[]
  healthRecords    HealthRecord[]
  insurancePolicies InsurancePolicy[]
  coopMemberships  CoopMembership[]
  coldChainEvents  ColdChainEvent[]
  feedback         Feedback[]
  animalMovements  AnimalMovement[]
  flockMovements   FlockMovement[]
  inputVouchers    InputVoucher[]
  insuranceClaims  InsuranceClaim[]
  savingsEntries   SavingsEntry[]
  budgetItems      BudgetItem[]

  @@map("farms")
}

/// A bee COLONY, which is the unit a beekeeper actually manages.
///
/// Bees are never recorded or tagged individually — a colony is tens of
/// thousands of insects. Real apiary practice (and every beekeeping logbook)
/// records per hive: colony strength, queen status, stores, varroa counts and
/// honey harvested. This mirrors how a flock works for poultry: the unit is the
/// thing you count, not the animal.
model Hive {
  id           Int       @id @default(autoincrement())
  farmId       Int       @map("farm_id")
  name         String // the hive number painted on the box
  hiveType     String?   @map("hive_type") // langstroth | topbar | traditional | flow
  status       String    @default("active") // active | weak | swarm | dead | requeened
  queenYear    Int?      @map("queen_year")
  queenStatus  String?   @map("queen_status") // seen | not_seen | new | laying_weak
  frames       Int?
  location     String? // apiary / stand position
  establishedOn DateTime? @map("established_on") @db.Date
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  farm        Farm             @relation(fields: [farmId], references: [id], onDelete: Cascade)
  inspections HiveInspection[]

  @@unique([farmId, name])
  @@index([farmId, status])
  @@map("hives")
}

/// One hive inspection: what the beekeeper looks at on the box.
model HiveInspection {
  id          Int      @id @default(autoincrement())
  hiveId      Int      @map("hive_id")
  inspectedAt DateTime @map("inspected_at")
  broodFrames Int?     @map("brood_frames")
  storesFrames Int?    @map("stores_frames")
  queenSeen   Boolean? @map("queen_seen")
  queenCells  Int?     @map("queen_cells")
  varroaCount Int?     @map("varroa_count")
  honeyKg     Decimal? @map("honey_kg") @db.Decimal(10, 2)
  actionTaken String?  @map("action_taken") // e.g. treatment, requeen, super
  notes       String?
  createdBy   Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  hive Hive @relation(fields: [hiveId], references: [id], onDelete: Cascade)

  @@index([hiveId, inspectedAt])
  @@map("hive_inspections")
}

model FarmMember {
  id       Int      @id @default(autoincrement())
  userId   Int      @map("user_id")
  farmId   Int      @map("farm_id")
  role     String   @default("member")
  joinedAt DateTime @default(now()) @map("joined_at")

  user User @relation(fields: [userId], references: [id])
  farm Farm @relation(fields: [farmId], references: [id])

  @@unique([userId, farmId])
  @@map("farm_members")
}

model Flock {
  id           Int       @id @default(autoincrement())
  farmId       Int       @map("farm_id")
  name         String
  breed        String?
  initialCount Int       @map("initial_count")
  currentCount Int       @map("current_count")
  mortality    Int       @default(0)
  hatchDate    DateTime? @map("hatch_date")
  status       String    @default("active")
  type         String?   @default("layers")

  // ─── Extended fields (multi-species livestock) ───
  category         String?  @default("poultry")
  purpose          String? // production, breeding, dual_purpose
  gender           String? // male, female, mixed
  genderRatio      String?  @map("gender_ratio")
  location         String? // pen, barn, pond, coop designation
  source           String? // supplier name
  supplierContact  String?  @map("supplier_contact")
  costPerAnimal    Decimal? @map("cost_per_animal") @db.Decimal(10, 2)
  totalInvestment  Decimal? @map("total_investment") @db.Decimal(12, 2)
  targetMarket     String?  @map("target_market")
  feedType         String?  @map("feed_type")
  feedSupplier     String?  @map("feed_supplier")
  feedCostPerMonth Decimal? @map("feed_cost_per_month") @db.Decimal(10, 2)
  vetName          String?  @map("vet_name")
  vetPhone         String?  @map("vet_phone")
  healthOnArrival  String?  @map("health_on_arrival")
  insurancePolicy  String?  @map("insurance_policy")
  photoUrl         String?  @map("photo_url")
  expectedYield    String?  @map("expected_yield")
  expectedRevenue  Decimal? @map("expected_revenue") @db.Decimal(12, 2)
  expectedWeight   String?  @map("expected_weight")
  // ANITRAC tag range issued to this flock. Three numbers cover 500 animals —
  // the farmer never types a number per head. Individual tags are generated on
  // demand for traceability lists. See `animals` for individually-tracked stock.
  tagFrom          String?  @map("tag_from")
  tagTo            String?  @map("tag_to")
  taggedCount      Int?     @map("tagged_count")
  taggedOn         DateTime? @map("tagged_on")
  /// C8: asset-register fields. A herd IS capital — the biggest one most
  /// smallholders own — and `costPerAnimal`/`totalInvestment` already record
  /// what it cost. These three let a book value be computed honestly:
  /// `acquiredOn` starts the clock, `usefulLifeYears` is the farmer's own
  /// expectation for the class of stock, and `salvageValue` is what it is worth
  /// at the end. All optional: with none of them set, the register shows cost and
  /// says book value is not computable rather than depreciating on a default we
  /// invented.
  acquiredOn       DateTime? @map("acquired_on") @db.Date
  usefulLifeYears  Int?      @map("useful_life_years")
  salvageValue     Decimal?  @map("salvage_value") @db.Decimal(12, 2)
  notes            String?

  createdBy Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  farm         Farm              @relation(fields: [farmId], references: [id])
  creator      User?             @relation(fields: [createdBy], references: [id])
  production   DailyProduction[]
  animalProduction AnimalProduction[]
  vaccinations Vaccination[]
  breeding     Breeding[]
  animals      Animal[]
  healthRecords       HealthRecord[]
  insurancePolicies   InsurancePolicy[]
  transactions Transaction[]
  movements    FlockMovement[]
  batches      FlockBatch[]

  @@map("flocks")
}

/// A sub-group inside one flock — "the original 300" vs "the 200 I bought in
/// October" — for a farmer who wants ONE flock (one total count, one place to
/// manage it) but still wants to tell its history apart internally.
///
/// This is deliberately NOT another Flock. A Flock is the unit that appears in
/// the farmer's list and carries the species/category guard on merges; a batch
/// only exists inside one flock and is never listed on its own. `Flock.
/// currentCount` remains the single source of truth for the flock's total — a
/// batch's `currentCount` is a partition of that total, not a second ledger.
///
/// Created two ways: directly by the farmer ("add a batch"), or automatically
/// when a flock-to-flock merge is done with `asBatch: true` — see
/// routes/flocks.ts — so combining three branches' groups into one flock does
/// not have to mean losing the fact that they arrived separately.
model FlockBatch {
  id              Int       @id @default(autoincrement())
  farmId          Int       @map("farm_id")
  flockId         Int       @map("flock_id")
  name            String
  currentCount    Int       @map("current_count")
  acquiredOn      DateTime? @map("acquired_on") @db.Date
  // Set when this batch was created BY a merge, so its origin stays readable
  // without having to resolve the now-archived flock it came from.
  sourceFlockName String?   @map("source_flock_name")
  notes           String?
  status          String    @default("active") // active | merged
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  farm    Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  flock   Flock    @relation(fields: [flockId], references: [id], onDelete: Cascade)
  animals Animal[]

  @@index([farmId])
  @@index([flockId])
  @@map("flock_batches")
}

/// The herd ledger — WHY a group's head count changed.
///
/// `Flock.currentCount` is one number that gets overwritten in place, so a
/// farmer could never answer "I had 40, now I have 33 — where did seven go?".
/// A row is written for every change that is not a plain correction: purchase,
/// birth, transfer between this farm's OWN groups, merge, sale, death. The
/// count stays the daily source of truth; this is the audit trail beside it,
/// and it is what makes a group-to-group transfer defensible to a buyer or a
/// county officer later.
///
/// A transfer writes TWO rows — one on each group, with opposite deltas — so
/// both sides of the same event agree and neither group's history is a guess.
model FlockMovement {
  id       Int    @id @default(autoincrement())
  farmId   Int    @map("farm_id")
  flockId  Int    @map("flock_id")
  // Signed: +N into this group, -N out of it.
  delta    Int
  // purchase | birth | transfer_in | transfer_out | merged_in | merged_out
  // | split_in | split_out | sale | death | adjustment
  reason   String
  // The OTHER group in a transfer or merge, when there was one. A plain Int,
  // deliberately NOT a relation: the counterparty may later be merged away or
  // deleted, and a ledger row must never be orphaned by that. The name is
  // snapshotted alongside so the row still reads correctly afterwards.
  counterpartyFlockId Int?    @map("counterparty_flock_id")
  counterpartyName    String? @map("counterparty_name")
  countBefore Int     @map("count_before")
  countAfter  Int     @map("count_after")
  movedAt     DateTime @map("moved_at") @db.Date
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  farm  Farm  @relation(fields: [farmId], references: [id], onDelete: Cascade)
  flock Flock @relation(fields: [flockId], references: [id], onDelete: Cascade)

  @@index([farmId, movedAt])
  @@index([flockId])
  @@map("flock_movements")
}

model DailyProduction {
  id            Int      @id @default(autoincrement())
  flockId       Int      @map("flock_id")
  farmId        Int      @map("farm_id")
  date          DateTime @db.Date
  eggsCollected Int      @default(0) @map("eggs_collected")
  milkCollected Decimal  @default(0) @map("milk_collected") @db.Decimal(10, 2)
  mortality     Int      @default(0)
  feedUsed      Decimal  @default(0) @map("feed_used") @db.Decimal(10, 2)
  avgWeight     Decimal? @map("avg_weight") @db.Decimal(10, 2)
  weightGain    Decimal? @map("weight_gain") @db.Decimal(10, 2)
  waterUsed     Decimal? @map("water_used") @db.Decimal(10, 2)
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  flock  Flock   @relation(fields: [flockId], references: [id])
  farm   Farm    @relation(fields: [farmId], references: [id])

  @@unique([flockId, date])
  @@map("daily_production")
}

/// Per-cow milk yield — one milking-level fact about ONE animal.
///
/// Deliberately its own table rather than a nullable `animalId` on
/// DailyProduction, for two reasons that are constraints, not taste:
///
///  1. **A nullable column cannot join that unique key safely.**
///     DailyProduction is uniquely keyed on `(flock_id, date)` and the daily
///     ritual upserts against it. Widening that key to include a nullable
///     `animal_id` would silently stop guarding the flock-level rows, because
///     PostgreSQL treats NULLs as distinct in a unique index — every flock
///     upsert would start INSERTing duplicates instead of updating. Keeping
///     every column here NOT NULL (or defaulted) is what makes the key hold.
///  2. **A cow's yield and a flock's yield are different grains of fact.**
///     The flock total is the number the farmer logs daily and the number the
///     statement and unit economics already read. A per-cow row is detail on
///     top of it. Separate tables mean a per-cow sum can never be mistaken for
///     the flock's, and the flock total stays the single daily fact.
///
/// `session` makes "per animal, by milking" expressible (morning/evening are
/// how zero-grazing is actually done) and is NOT NULL with a default so the
/// unique key below genuinely holds.
model AnimalProduction {
  id         Int      @id @default(autoincrement())
  farmId     Int      @map("farm_id")
  animalId   Int      @map("animal_id")
  /// The flock the cow was in THAT DAY. Recorded rather than derived, because
  /// an animal can be moved between flocks and its history should not move
  /// with it. Null only for an animal not currently in any flock.
  flockId    Int?     @map("flock_id")
  date       DateTime @db.Date
  /// morning | evening | full_day — one milking or the whole day's total.
  session    String   @default("full_day")
  milkLitres Decimal  @default(0) @map("milk_litres") @db.Decimal(10, 2)
  notes      String?
  recordedBy Int?     @map("recorded_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)
  flock  Flock? @relation(fields: [flockId], references: [id], onDelete: SetNull)

  @@unique([animalId, date, session])
  @@index([farmId, date])
  @@index([flockId, date])
  @@map("animal_production")
}

model Breeding {
  id             Int       @id @default(autoincrement())
  flockId        Int       @map("flock_id")
  farmId         Int       @map("farm_id")
  sireName       String?   @map("sire_name")
  sireBreed      String?   @map("sire_breed")
  damName        String?   @map("dam_name")
  damBreed       String?   @map("dam_breed")
  /// Nullable so a HEAT (A4) can live on this timeline before any service
  /// happened. A heat with no mating date is a real, useful observation — it is
  /// how a farmer knows when to expect the next one — and forcing a service date
  /// onto it would mean either inventing one or losing the record.
  matingDate     DateTime? @map("mating_date")
  /// A4: the day the animal was seen in heat, and what was actually seen
  /// (standing, mucus, bellowing). Structured, not free text, because the whole
  /// value is arithmetic: 21 days later is the next expected heat.
  heatObservedAt DateTime? @map("heat_observed_at") @db.Date
  heatSigns      String?   @map("heat_signs")
  /// A3: the day milking stopped ahead of the next calving. Days-in-milk and
  /// the dry period are what a farmer actually manages by, and neither is
  /// derivable from a calving date alone.
  dryOffDate     DateTime? @map("dry_off_date") @db.Date
  expectedBirth  DateTime? @map("expected_birth")
  actualBirth    DateTime? @map("actual_birth")
  offspringCount Int?      @map("offspring_count")
  offspringAlive Int?      @map("offspring_alive")
  method         String? // natural, ai, ivf
  status         String    @default("pending") // heat, pending, confirmed, born, failed, dried_off
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")

  flock Flock @relation(fields: [flockId], references: [id])
  farm  Farm  @relation(fields: [farmId], references: [id])

  @@map("breeding_records")
}

/// A distinct place on the farm that crops grow on (farmer-requested gap §2 B1/B2).
///
/// A crop farm is not one record with an acreage — it is several distinct plots
/// with different soil, crops, inputs and pest pressure. Almost every agronomy
/// gap follows from the missing plot: rotation history, per-plot yield,
/// pest scouting, and — for coffee — the geolocation an EU buyer can trace a
/// delivery back to. The plot is the "real place"; crops, harvests and
/// applications hang off it.
///
/// The EUDR framing (never overstate): a Kenyan smallholder's practical deadline
/// is the day their buyer asks, not a statutory date served on them. We COLLECT
/// the geolocation and let the farmer hand their buyer a traceable chain — we
/// never assert a legal obligation. Latitude/longitude follow the farm's same
/// both-or-neither rule (one coordinate alone is a point in the Indian Ocean),
/// so partial input is rejected, not silently half-saved.
model Plot {
  id         Int      @id @default(autoincrement())
  farmId     Int      @map("farm_id")
  name       String // e.g. "Coffee block C"
  areaValue  Decimal? @map("area_value") @db.Decimal(10, 2)
  areaUnit   String?  @map("area_unit") // "acre" | "hectare"
  latitude   Decimal? @map("latitude") @db.Decimal(10, 7)
  longitude  Decimal? @map("longitude") @db.Decimal(10, 7)
  soilType   String?  @map("soil_type")
  notes      String?
  createdBy  Int?     @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  farm    Farm   @relation(fields: [farmId], references: [id])
  creator User?  @relation(fields: [createdBy], references: [id])
  crops   Crop[]

  @@map("plots")
}

model Crop {
  id              Int       @id @default(autoincrement())
  farmId          Int       @map("farm_id")
  name            String // e.g. "Maize Field A"
  cropType        String    @map("crop_type") // maize, beans, tomatoes, kale, etc.
  variety         String? // e.g. "H614" for maize
  areaAcres       Decimal?  @map("area_acres") @db.Decimal(10, 2)
  plantingDate    DateTime? @map("planting_date")
  expectedHarvest DateTime? @map("expected_harvest")
  status          String    @default("active") // active, harvested, failed
  location        String? // free-text field/plot designation (kept for backwards compat)
  plotId          Int?      @map("plot_id") // the real place this crop stands on (B1)
  soilType        String?   @map("soil_type")
  irrigation      String? // rainfed, drip, sprinkler, flood
  isPerennial     Boolean   @default(false) @map("is_perennial") // true for orchard crops (avocado, macadamia, mango, coffee...)
  maturityYears   Int?      @map("maturity_years") // years from planting to first commercial harvest (macadamia 3-5, avocado 3-4)
  yearsInProduction Int?    @map("years_in_production") // completed production seasons (perennial crops only)
  harvestSeason   String?   @map("harvest_season") // e.g. "Apr-Sep" (avocado), "Mar-Jun" (mango main crop)
  /// B6: what the farmer EXPECTS this crop to give, in kg. A number they state,
  /// not one we infer from a variety table — because a "potential yield" from a
  /// research station is guidance for a district and a promise to nobody. The
  /// variance view compares their own figure with their own harvest, and says
  /// "estimate" wherever it could be mistaken for a forecast.
  expectedYieldKg Decimal?  @map("expected_yield_kg") @db.Decimal(10, 2)
  notes           String?
  createdBy       Int?      @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  farm         Farm              @relation(fields: [farmId], references: [id])
  creator      User?             @relation(fields: [createdBy], references: [id])
  plot         Plot?             @relation(fields: [plotId], references: [id])
  harvests     CropHarvest[]
  health       CropHealth[]
  applications CropApplication[]
  postHarvestBatches PostHarvestBatch[]
  soilTests    SoilTest[]
  transactions Transaction[]

  @@map("crops")
}

model CropHarvest {
  id           Int      @id @default(autoincrement())
  cropId       Int      @map("crop_id")
  farmId       Int      @map("farm_id")
  date         DateTime @db.Date
  quantityKg   Decimal  @map("quantity_kg") @db.Decimal(10, 2)
  quality      String? // grade A, B, C
  soldQuantity Decimal? @map("sold_quantity") @db.Decimal(10, 2)
  salePrice    Decimal? @map("sale_price") @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  crop Crop @relation(fields: [cropId], references: [id])
  farm Farm @relation(fields: [farmId], references: [id])

  @@map("crop_harvests")
}

model CropHealth {
  id          Int       @id @default(autoincrement())
  cropId      Int       @map("crop_id")
  farmId      Int       @map("farm_id")
  date        DateTime  @db.Date
  issueType   String    @map("issue_type") // pest, disease, weed, nutrient
  description String
  severity    String    @default("low") // low, medium, high
  treatment   String?
  treatedDate DateTime? @map("treated_date")
  /// B3: structured scouting. "High" is a feeling; "14 of 50 plants infested"
  /// is a fact a farmer can act on and compare to last week. The two counts are
  /// what make an incidence percentage computable without a second table.
  sampleSize     Int?      @map("sample_size")
  affectedCount  Int?      @map("affected_count")
  /// e.g. larva | adult | egg | egg_mass — coffee berry borer and fall armyworm
  /// are treated differently at different stages, so the stage is part of the
  /// record rather than prose inside `description`.
  pestStage   String?   @map("pest_stage")
  /// When the farmer intends to look again. A scouting record with no follow-up
  /// is a diary entry; this is what turns it into a loop.
  followUpOn  DateTime? @map("follow_up_on") @db.Date
  outcome     String? // resolved, ongoing, failed
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  crop Crop @relation(fields: [cropId], references: [id])
  farm Farm @relation(fields: [farmId], references: [id])

  @@map("crop_health")
}

model CropApplication {
  id          Int      @id @default(autoincrement())
  cropId      Int      @map("crop_id")
  farmId      Int      @map("farm_id")
  date        DateTime @db.Date
  type        String // fertilizer, pesticide, herbicide, irrigation
  productName String   @map("product_name")
  quantity    Decimal  @db.Decimal(10, 2)
  unit        String // kg, litres, bags
  cost        Decimal? @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  crop Crop @relation(fields: [cropId], references: [id])
  farm Farm @relation(fields: [farmId], references: [id])

  phiDays         Int?      @map("phi_days") // pre-harvest interval (days) — export compliance: min days between pesticide application and harvest

  @@map("crop_applications")
}

// Post-harvest handling chain — for export-grade crops (avocado, mango, macadamia).
// Tracks each batch from harvest through grading, treatment, cold storage and packing.
model PostHarvestBatch {
  id            Int      @id @default(autoincrement())
  cropId        Int      @map("crop_id")
  farmId        Int      @map("farm_id")
  batchCode     String   @map("batch_code") // traceability code e.g. "AV-2026-001"
  harvestDate   DateTime @map("harvest_date")
  quantityKg    Decimal  @map("quantity_kg") @db.Decimal(10, 2)

  // Grading (e.g. avocado dry matter: <21% reject, 24-28% export, >28% premium)
  grade         String? // e.g. "Export", "Premium Export", "Domestic", "Reject"
  dryMatterPct  Decimal? @map("dry_matter_pct") @db.Decimal(5, 2) // avocado/macadamia export criterion

  // Post-harvest treatment (mango EU exports require HWT/VHT; avocado fungicide dip)
  treatment     String? // HWT, VHT, fungicide dip, waxing...
  treatmentDate DateTime? @map("treatment_date")

  // Cold chain (avocado: cool to 5°C within 5h of harvest)
  cooledAt      DateTime? @map("cooled_at") // when batch reached storage temperature
  storageTempC  Decimal? @map("storage_temp_c") @db.Decimal(5, 2)
  storageExitedAt DateTime? @map("storage_exited_at")

  // Packing & dispatch
  packedQtyKg   Decimal? @map("packed_qty_kg") @db.Decimal(10, 2)
  cartons       Int? // e.g. avocado 4kg cartons
  status        String   @default("harvested") // harvested, graded, treated, stored, packed, dispatched, rejected
  destination   String? // e.g. "EU export", "Local market", "Processing"
  phytoCertNo   String?  @map("phyto_cert_no") // KEPHIS phytosanitary certificate number
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  crop Crop @relation(fields: [cropId], references: [id])
  farm Farm @relation(fields: [farmId], references: [id])
  coldChain ColdChainEvent[]

  @@map("post_harvest_batches")
}

// Soil test records — KALRO/Farm Africa guidance: test before planting and before fertiliser recommendation.
model SoilTest {
  id          Int      @id @default(autoincrement())
  cropId      Int?     @map("crop_id") // optional — a test may be for a field not yet planted
  farmId      Int      @map("farm_id")
  date        DateTime @db.Date
  labName     String?  @map("lab_name")
  ph          Decimal? @db.Decimal(4, 2) // e.g. beans need 5.8-6.5; <5.2 is too acidic
  nitrogen    String? // e.g. "low", "medium", "high"
  phosphorus  String? @map("phosphorus")
  potassium   String? // KALRO style low/medium/high
  organicMatterPct Decimal? @map("organic_matter_pct") @db.Decimal(5, 2)
  recommendation String? // agronomist's advice e.g. "apply lime 2t/ha"
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  crop Crop? @relation(fields: [cropId], references: [id])
  farm Farm  @relation(fields: [farmId], references: [id])

  @@map("soil_tests")
}

model Vaccination {
  id            Int       @id @default(autoincrement())
  flockId       Int       @map("flock_id")
  animalId      Int?      @map("animal_id") // optional: a specific tagged animal, not the whole flock
  vaccineName   String    @map("vaccine_name")
  scheduledDate DateTime  @map("scheduled_date")
  completedDate DateTime? @map("completed_date")
  status        String    @default("pending")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  flock  Flock   @relation(fields: [flockId], references: [id])
  animal Animal? @relation(fields: [animalId], references: [id], onDelete: SetNull)

  @@index([animalId])
  @@map("vaccinations")
}

/// Individual animal identity for ANITRAC traceability.
///
/// Kenya rolled out ANITRAC in July 2026: every cattle, sheep and goat carries
/// a 15-digit number starting with the 141 country prefix (visual tag left ear,
/// RFID chip right ear). This model stores the tag the farmer ALREADY has and
/// ties it to the farm's day-to-day record.
///
/// Deliberate design: the farmer does NOT manage animals individually. The
/// flock's `currentCount` stays the daily source of truth; an Animal row is
/// set up once and thereafter only ever VIEWED. Nothing here is required to
/// log production — the existing flock flow is untouched.
/// ANITRAC §20 — where a tagged animal has been. Mostly off-farm or
/// between-premises movements the farmer records when they happen (or the
/// county asks later), plus the moves between the farm's OWN groups, which
/// POST /api/flocks/transfer writes automatically rather than asking the farmer
/// to describe the same event twice. The traceability chain is built from these
/// rows on demand, never pre-computed.
model AnimalMovement {
  id          Int      @id @default(autoincrement())
  farmId      Int      @map("farm_id")
  animalId    Int      @map("animal_id")
  // Where from / where to. Free text premises names — the county register's
  // vocabulary, not ours. Both required: a movement with one end is a guess.
  fromPremises String  @map("from_premises")
  toPremises   String  @map("to_premises")
  movedAt     DateTime @map("moved_at") @db.Date
  // sale | transfer | grazing | vet | quarantine | other — the reasons the
  // movement form offers — plus `group_move`, which the group-to-group transfer
  // writes itself. Kept as a String rather than an enum so a reason can be
  // added without a migration; the closed set lives in lib/animal-movement.ts.
  reason      String   @default("transfer")
  // Movement permit reference, when the county issued one. Optional —
  // recording a movement must never be blocked on paperwork the farmer
  // may not have been given.
  permitRef   String?  @map("permit_ref")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([farmId, movedAt])
  @@index([animalId])
  @@map("animal_movements")
}

model Animal {
  id        Int       @id @default(autoincrement())
  farmId    Int       @map("farm_id")
  flockId   Int?      @map("flock_id")
  // Optional sub-group within that flock. Always NULL for farmers who never
  // use batches — this is strictly additive, nothing existing changes shape.
  batchId   Int?      @map("batch_id")
  tagNumber String    @map("tag_number") // ANITRAC: 15 digits, starts with 141
  species   String?
  breed     String?
  sex       String? // female | male | unknown
  birthDate DateTime? @map("birth_date") @db.Date
  status    String    @default("active") // active | sold | moved | died | missing
  notes     String?
  photoUrl  String?   @map("photo_url")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // The mother, when the calf is recorded as an animal. Turns a breeding
  // record's offspringAlive number into actual, individually trackable calves
  // — colostrum, rearing and calf mortality become per-animal records.
  damId     Int?      @map("dam_id")
  farm        Farm          @relation(fields: [farmId], references: [id], onDelete: Cascade)
  flock       Flock?        @relation(fields: [flockId], references: [id], onDelete: SetNull)
  batch       FlockBatch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  dam         Animal?       @relation("Calf", fields: [damId], references: [id], onDelete: SetNull)
  calves      Animal[]      @relation("Calf")
  vaccinations Vaccination[]
  healthRecords HealthRecord[]
  movements   AnimalMovement[]
  productionRecords AnimalProduction[]

  @@unique([farmId, tagNumber])
  @@index([farmId, status])
  @@index([flockId])
  @@index([batchId])
  @@map("animals")
}

model Transaction {
  id            Int      @id @default(autoincrement())
  farmId        Int      @map("farm_id")
  type          String
  category      String?
  docCode       String?  @map("doc_code")
  amount        Decimal  @db.Decimal(12, 2)
  description   String?
  date          DateTime @db.Date
  paymentMethod String?  @map("payment_method")
  reference     String?
  // M1: canonical classification of the free-text `category`, derived by
  // lib/ledger-taxonomy.ts. Nullable — back-filled for existing rows, and
  // classified on read while still null.
  costBucket     String? @map("cost_bucket")
  enterpriseKind String? @map("enterprise_kind")
  // M1: explicit enterprise attribution, replacing substring-matching on the
  // flock's name in profitability.ts. Optional; ON DELETE SET NULL.
  flockId       Int?     @map("flock_id")
  cropId        Int?     @map("crop_id")
  /// C3: the delivery this income finally settled, once the farmer (or we, on
  /// their behalf) matched the M-Pesa receipt to the milk they delivered. Null =
  /// unmatched, which is the honest default: an unmatched receipt is why a
  /// farmer believes they were not paid.
  deliveryId    Int?     @map("delivery_id")
  matchedAt     DateTime? @map("matched_at")
  /// How the match was made: "manual" (the farmer confirmed it), "reference"
  /// (receipt numbers agreed) or "proposed" (we suggested, nobody confirmed yet).
  /// A confirmed match is never silently overwritten by a later proposal.
  matchedBy     String?  @map("matched_by")
  /// Landed unit-cost economics: quantity bought/sold (e.g. 50kg, 2 bags) and unit cost (KES/unit)
  quantity      Decimal? @db.Decimal(12, 2)
  unitCost      Decimal? @map("unit_cost") @db.Decimal(12, 2)
  supplierName  String?  @map("supplier_name")
  createdBy     Int?     @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  farm  Farm   @relation(fields: [farmId], references: [id])
  user  User?  @relation(fields: [createdBy], references: [id])
  flock Flock? @relation(fields: [flockId], references: [id])
  crop  Crop?  @relation(fields: [cropId], references: [id])

  @@index([farmId, costBucket])
  @@index([farmId, enterpriseKind])
  @@index([farmId, flockId])
  @@index([farmId, cropId])
  @@map("transactions")
}

model Inventory {
  id           Int       @id @default(autoincrement())
  farmId       Int       @map("farm_id")
  itemName     String    @map("item_name")
  category     String?
  quantity     Decimal   @db.Decimal(10, 2)
  unit         String    @default("bags")
  unitCost     Decimal   @map("unit_cost") @db.Decimal(10, 2)
  reorderLevel Int       @default(0) @map("reorder_level")
  supplier     String?
  expiryDate   DateTime? @map("expiry_date")
  // Batch number for vet drugs, vaccines and any item with a per-batch
  // expiry. Free Core uses this to surface expiring-soon inventory.
  batchNo      String?  @map("batch_no")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")

  farm Farm           @relation(fields: [farmId], references: [id])
  logs InventoryLog[]

  @@map("inventory")
}

model InventoryLog {
  id             Int      @id @default(autoincrement())
  inventoryId    Int      @map("inventory_id")
  changeType     String   @map("change_type")
  quantityChange Decimal  @map("quantity_change") @db.Decimal(10, 2)
  reason         String?
  createdBy      Int?     @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  inventory Inventory @relation(fields: [inventoryId], references: [id])

  @@map("inventory_logs")
}

model Customer {
  id          Int      @id @default(autoincrement())
  farmId      Int      @map("farm_id")
  name        String
  phone       String?
  email       String?
  address     String?
  totalCredit Decimal  @default(0) @map("total_credit") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  farm     Farm       @relation(fields: [farmId], references: [id])
  sales    Sale[]
  credits  Credit[]
  invoices Invoice[]
  quotes   Quote[]
  deliveries Delivery[]

  @@map("customers")
}

model Sale {
  id            Int      @id @default(autoincrement())
  farmId        Int      @map("farm_id")
  customerId    Int?     @map("customer_id")
  items         Json
  totalAmount   Decimal  @map("total_amount") @db.Decimal(12, 2)
