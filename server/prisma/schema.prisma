generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int       @id @default(autoincrement())
  name             String
  email            String    @unique
  phone            String?   @unique
  password         String?
  googleId         String?   @unique @map("google_id")
  avatar           String?
  role             String    @default("farm_owner")
  profileComplete  Boolean   @default(false) @map("profile_complete")
  emailVerified    DateTime? @map("email_verified")
  trialStartsAt    DateTime? @map("trial_starts_at")
  trialEndsAt      DateTime? @map("trial_ends_at")
  selectedHubs     String?   @map("selected_hubs")
  resetToken       String?   @map("reset_token")
  resetTokenExpiry DateTime? @map("reset_token_expiry")
  tokenVersion     Int       @default(0) @map("token_version")
  totpSecret       String?   @map("totp_secret")
  totpEnabledAt    DateTime? @map("totp_enabled_at")
  lastMfaNudgedAt  DateTime? @map("last_mfa_nudged_at")
  recoveryCodes    String?   @map("recovery_codes") // JSON array of bcrypt-hashed codes
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  farms         FarmMember[]
  ownedFarms    Farm[]
  flocks        Flock[]
  transactions  Transaction[]
  sales         Sale[]
  workers       Worker[]
  auditLogs     AuditLog[]
  tickets       Ticket[]
  crops         Crop[]
  verifications VerificationCode[]
  subscriptions Subscription[]

  @@map("users")
}

model VerificationCode {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  code      String
  purpose   String    @default("email_verification")
  attempts  Int       @default(0) // failed verification tries; code burns at 5
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_codes")
}

// Pricing source of truth — seeded from code once, editable in DB afterwards.
// amount is in Pesewas (Paystack minor unit) to avoid float money.
model Plan {
  id          String  @id
  name        String
  description String?
  amount      Int
  days        Int
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  @@map("plans")
}

// Editable website content (pricing page copy, contact page details, FAQs).
// JSON blob per page — the admin Website module writes it, public pages read
// it. Never delete rows: history is the audit trail via admin audit log.
model SiteContent {
  page      String   @id
  data      Json
  updatedBy Int?     @map("updated_by")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("site_content")
}

// ─── Delivery ledger ────────────────────────────────────────
// The farmer's dispute-proof record of produce delivered to a
// buyer (dairy/co-op/factory/broker) with money expected back.
// commodity: milk | coffee_cherry | maize | other
model Delivery {
  id          Int      @id @default(autoincrement())
  farmId      Int      @map("farm_id")
  docCode     String?  @map("doc_code")
  date        DateTime @db.Date
  commodity   String
  quantity    Decimal  @db.Decimal(12, 2) // litres / kg
  unit        String   @default("litres")
  buyer       String // "Brookside", "Githunguri Factory", broker name
  receiptRef  String?  @map("receipt_ref") // slip/receipt number from the buyer
  unitPrice   Decimal? @map("unit_price") @db.Decimal(12, 2) // KES per unit, if known
  expectedPay Decimal? @map("expected_pay") @db.Decimal(12, 2) // gross expected for this delivery
  status      String   @default("pending") // pending | paid | disputed
  paidAmount  Decimal? @map("paid_amount") @db.Decimal(12, 2)
  notes       String?
  createdBy   Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  farm       Farm                @relation(fields: [farmId], references: [id])
  deductions DeliveryDeduction[]

  @@index([farmId, date])
  @@index([farmId, commodity])
  @@map("deliveries")
}

// Check-off deductions taken by the buyer from the payout
// (AI services, agrovet input credit, transport levy, etc.)
model DeliveryDeduction {
  id         Int     @id @default(autoincrement())
  deliveryId Int     @map("delivery_id")
  label      String // "AI service", "Agrovet credit", "Transport"
  amount     Decimal @db.Decimal(12, 2)

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@map("delivery_deductions")
}

model Subscription {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  plan      String
  planName  String    @map("plan_name")
  amount    Decimal   @db.Decimal(12, 2)
  status    String    @default("active")
  reference String?
  startsAt  DateTime  @default(now()) @map("starts_at")
  expiresAt DateTime  @map("expires_at")
  renewedAt DateTime? @map("renewed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("subscriptions")
}

model Farm {
  id        Int      @id @default(autoincrement())
  name      String
  code      String?  @unique
  location  String?
  county    String?
  farmType  String?  @map("farm_type")
  ownerId   Int      @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")

  owner            User              @relation(fields: [ownerId], references: [id])
  members          FarmMember[]
  flocks           Flock[]
  transactions     Transaction[]
  inventory        Inventory[]
  announcements    Announcement[]
  customers        Customer[]
  sales            Sale[]
  workers          Worker[]
  deliveries       Delivery[]
  feedRecipes      FeedRecipe[]
  weatherCache     WeatherCache[]
  dailyProductions DailyProduction[]
  credits          Credit[]
  attendances      Attendance[]
  auditLogs        AuditLog[]
  settings         FarmSetting[]
  workerTasks      WorkerTask[]
  workerLogs       WorkerLog[]
  zktecoDevices    ZKTecoDevice[]
  zktecoLogs       ZKTecoLog[]
  breeding         Breeding[]
  crops            Crop[]
  cropHarvests     CropHarvest[]
  cropHealth       CropHealth[]
  cropApplications CropApplication[]
  postHarvestBatches PostHarvestBatch[]
  soilTests        SoilTest[]
  invoices         Invoice[]
  quotes           Quote[]
  newsSends        NewsArticleSend[]

  @@map("farms")
}

model FarmMember {
  id       Int      @id @default(autoincrement())
  userId   Int      @map("user_id")
  farmId   Int      @map("farm_id")
  role     String   @default("member")
  joinedAt DateTime @default(now()) @map("joined_at")

  user User @relation(fields: [userId], references: [id])
  farm Farm @relation(fields: [farmId], references: [id])

  @@unique([userId, farmId])
  @@map("farm_members")
}

model Flock {
  id           Int       @id @default(autoincrement())
  farmId       Int       @map("farm_id")
  name         String
  breed        String?
  initialCount Int       @map("initial_count")
  currentCount Int       @map("current_count")
  mortality    Int       @default(0)
  hatchDate    DateTime? @map("hatch_date")
  status       String    @default("active")
  type         String?   @default("layers")

  // ─── Extended fields (multi-species livestock) ───
  category         String?  @default("poultry")
  purpose          String? // production, breeding, dual_purpose
  gender           String? // male, female, mixed
  genderRatio      String?  @map("gender_ratio")
  location         String? // pen, barn, pond, coop designation
  source           String? // supplier name
  supplierContact  String?  @map("supplier_contact")
  costPerAnimal    Decimal? @map("cost_per_animal") @db.Decimal(10, 2)
  totalInvestment  Decimal? @map("total_investment") @db.Decimal(12, 2)
  targetMarket     String?  @map("target_market")
  feedType         String?  @map("feed_type")
  feedSupplier     String?  @map("feed_supplier")
  feedCostPerMonth Decimal? @map("feed_cost_per_month") @db.Decimal(10, 2)
  vetName          String?  @map("vet_name")
  vetPhone         String?  @map("vet_phone")
  healthOnArrival  String?  @map("health_on_arrival")
  insurancePolicy  String?  @map("insurance_policy")
  photoUrl         String?  @map("photo_url")
  expectedYield    String?  @map("expected_yield")
  expectedRevenue  Decimal? @map("expected_revenue") @db.Decimal(12, 2)
  expectedWeight   String?  @map("expected_weight")
  notes            String?

  createdBy Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  farm         Farm              @relation(fields: [farmId], references: [id])
  creator      User?             @relation(fields: [createdBy], references: [id])
  production   DailyProduction[]
  vaccinations Vaccination[]
  breeding     Breeding[]

  @@map("flocks")
}

model DailyProduction {
  id            Int      @id @default(autoincrement())
  flockId       Int      @map("flock_id")
  farmId        Int      @map("farm_id")
  date          DateTime @db.Date
  eggsCollected Int      @default(0) @map("eggs_collected")
  milkCollected Decimal  @default(0) @map("milk_collected") @db.Decimal(10, 2)
  mortality     Int      @default(0)
  feedUsed      Decimal  @default(0) @map("feed_used") @db.Decimal(10, 2)
  avgWeight     Decimal? @map("avg_weight") @db.Decimal(10, 2)
  weightGain    Decimal? @map("weight_gain") @db.Decimal(10, 2)
  waterUsed     Decimal? @map("water_used") @db.Decimal(10, 2)
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  flock Flock @relation(fields: [flockId], references: [id])
  farm  Farm  @relation(fields: [farmId], references: [id])

  @@unique([flockId, date])
  @@map("daily_production")
}

model Breeding {
  id             Int       @id @default(autoincrement())
  flockId        Int       @map("flock_id")
  farmId         Int       @map("farm_id")
  sireName       String?   @map("sire_name")
  sireBreed      String?   @map("sire_breed")
  damName        String?   @map("dam_name")
  damBreed       String?   @map("dam_breed")
  matingDate     DateTime  @map("mating_date")
  expectedBirth  DateTime? @map("expected_birth")
  actualBirth    DateTime? @map("actual_birth")
  offspringCount Int?      @map("offspring_count")
  offspringAlive Int?      @map("offspring_alive")
  method         String? // natural, ai, ivf
  status         String    @default("pending") // pending, confirmed, born, failed
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")

  flock Flock @relation(fields: [flockId], references: [id])
  farm  Farm  @relation(fields: [farmId], references: [id])

  @@map("breeding_records")
}

model Crop {
  id              Int       @id @default(autoincrement())
  farmId          Int       @map("farm_id")
  name            String // e.g. "Maize Field A"
  cropType        String    @map("crop_type") // maize, beans, tomatoes, kale, etc.
  variety         String? // e.g. "H614" for maize
  areaAcres       Decimal?  @map("area_acres") @db.Decimal(10, 2)
  plantingDate    DateTime? @map("planting_date")
  expectedHarvest DateTime? @map("expected_harvest")
  status          String    @default("active") // active, harvested, failed
  location        String? // field/plot designation
  soilType        String?   @map("soil_type")
  irrigation      String? // rainfed, drip, sprinkler, flood
  isPerennial     Boolean   @default(false) @map("is_perennial") // true for orchard crops (avocado, macadamia, mango, coffee...)
  maturityYears   Int?      @map("maturity_years") // years from planting to first commercial harvest (macadamia 3-5, avocado 3-4)
  yearsInProduction Int?    @map("years_in_production") // completed production seasons (perennial crops only)
  harvestSeason   String?   @map("harvest_season") // e.g. "Apr-Sep" (avocado), "Mar-Jun" (mango main crop)
  notes           String?
  createdBy       Int?      @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  farm         Farm              @relation(fields: [farmId], references: [id])
  creator      User?             @relation(fields: [createdBy], references: [id])
  harvests     CropHarvest[]
  health       CropHealth[]
  applications CropApplication[]
  postHarvestBatches PostHarvestBatch[]
  soilTests    SoilTest[]

  @@map("crops")
}

model CropHarvest {
  id           Int      @id @default(autoincrement())
  cropId       Int      @map("crop_id")
  farmId       Int      @map("farm_id")
  date         DateTime @db.Date
  quantityKg   Decimal  @map("quantity_kg") @db.Decimal(10, 2)
  quality      String? // grade A, B, C
  soldQuantity Decimal? @map("sold_quantity") @db.Decimal(10, 2)
  salePrice    Decimal? @map("sale_price") @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  crop Crop @relation(fields: [cropId], references: [id])
  farm Farm @relation(fields: [farmId], references: [id])

  @@map("crop_harvests")
}

model CropHealth {
  id          Int       @id @default(autoincrement())
  cropId      Int       @map("crop_id")
  farmId      Int       @map("farm_id")
  date        DateTime  @db.Date
  issueType   String    @map("issue_type") // pest, disease, weed, nutrient
  description String
  severity    String    @default("low") // low, medium, high
  treatment   String?
  treatedDate DateTime? @map("treated_date")
  outcome     String? // resolved, ongoing, failed
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  crop Crop @relation(fields: [cropId], references: [id])
  farm Farm @relation(fields: [farmId], references: [id])

  @@map("crop_health")
}

model CropApplication {
  id          Int      @id @default(autoincrement())
  cropId      Int      @map("crop_id")
  farmId      Int      @map("farm_id")
  date        DateTime @db.Date
  type        String // fertilizer, pesticide, herbicide, irrigation
  productName String   @map("product_name")
  quantity    Decimal  @db.Decimal(10, 2)
  unit        String // kg, litres, bags
  cost        Decimal? @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  crop Crop @relation(fields: [cropId], references: [id])
  farm Farm @relation(fields: [farmId], references: [id])

  phiDays         Int?      @map("phi_days") // pre-harvest interval (days) — export compliance: min days between pesticide application and harvest

  @@map("crop_applications")
}

// Post-harvest handling chain — for export-grade crops (avocado, mango, macadamia).
// Tracks each batch from harvest through grading, treatment, cold storage and packing.
model PostHarvestBatch {
  id            Int      @id @default(autoincrement())
  cropId        Int      @map("crop_id")
  farmId        Int      @map("farm_id")
  batchCode     String   @map("batch_code") // traceability code e.g. "AV-2026-001"
  harvestDate   DateTime @map("harvest_date")
  quantityKg    Decimal  @map("quantity_kg") @db.Decimal(10, 2)

  // Grading (e.g. avocado dry matter: <21% reject, 24-28% export, >28% premium)
  grade         String? // e.g. "Export", "Premium Export", "Domestic", "Reject"
  dryMatterPct  Decimal? @map("dry_matter_pct") @db.Decimal(5, 2) // avocado/macadamia export criterion

  // Post-harvest treatment (mango EU exports require HWT/VHT; avocado fungicide dip)
  treatment     String? // HWT, VHT, fungicide dip, waxing...
  treatmentDate DateTime? @map("treatment_date")

  // Cold chain (avocado: cool to 5°C within 5h of harvest)
  cooledAt      DateTime? @map("cooled_at") // when batch reached storage temperature
  storageTempC  Decimal? @map("storage_temp_c") @db.Decimal(5, 2)
  storageExitedAt DateTime? @map("storage_exited_at")

  // Packing & dispatch
  packedQtyKg   Decimal? @map("packed_qty_kg") @db.Decimal(10, 2)
  cartons       Int? // e.g. avocado 4kg cartons
  status        String   @default("harvested") // harvested, graded, treated, stored, packed, dispatched, rejected
  destination   String? // e.g. "EU export", "Local market", "Processing"
  phytoCertNo   String?  @map("phyto_cert_no") // KEPHIS phytosanitary certificate number
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  crop Crop @relation(fields: [cropId], references: [id])
  farm Farm @relation(fields: [farmId], references: [id])

  @@map("post_harvest_batches")
}

// Soil test records — KALRO/Farm Africa guidance: test before planting and before fertiliser recommendation.
model SoilTest {
  id          Int      @id @default(autoincrement())
  cropId      Int?     @map("crop_id") // optional — a test may be for a field not yet planted
  farmId      Int      @map("farm_id")
  date        DateTime @db.Date
  labName     String?  @map("lab_name")
  ph          Decimal? @db.Decimal(4, 2) // e.g. beans need 5.8-6.5; <5.2 is too acidic
  nitrogen    String? // e.g. "low", "medium", "high"
  phosphorus  String? @map("phosphorus")
  potassium   String? // KALRO style low/medium/high
  organicMatterPct Decimal? @map("organic_matter_pct") @db.Decimal(5, 2)
  recommendation String? // agronomist's advice e.g. "apply lime 2t/ha"
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  crop Crop? @relation(fields: [cropId], references: [id])
  farm Farm  @relation(fields: [farmId], references: [id])

  @@map("soil_tests")
}

model Vaccination {
  id            Int       @id @default(autoincrement())
  flockId       Int       @map("flock_id")
  vaccineName   String    @map("vaccine_name")
  scheduledDate DateTime  @map("scheduled_date")
  completedDate DateTime? @map("completed_date")
  status        String    @default("pending")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  flock Flock @relation(fields: [flockId], references: [id])

  @@map("vaccinations")
}

model Transaction {
  id            Int      @id @default(autoincrement())
  farmId        Int      @map("farm_id")
  type          String
  category      String?
  docCode       String?  @map("doc_code")
  amount        Decimal  @db.Decimal(12, 2)
  description   String?
  date          DateTime @db.Date
  paymentMethod String?  @map("payment_method")
  reference     String?
  createdBy     Int?     @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  farm Farm  @relation(fields: [farmId], references: [id])
  user User? @relation(fields: [createdBy], references: [id])

  @@map("transactions")
}

model Inventory {
  id           Int       @id @default(autoincrement())
  farmId       Int       @map("farm_id")
  itemName     String    @map("item_name")
  category     String?
  quantity     Decimal   @db.Decimal(10, 2)
  unit         String    @default("bags")
  unitCost     Decimal   @map("unit_cost") @db.Decimal(10, 2)
  reorderLevel Int       @default(0) @map("reorder_level")
  supplier     String?
  expiryDate   DateTime? @map("expiry_date")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")

  farm Farm           @relation(fields: [farmId], references: [id])
  logs InventoryLog[]

  @@map("inventory")
}

model InventoryLog {
  id             Int      @id @default(autoincrement())
  inventoryId    Int      @map("inventory_id")
  changeType     String   @map("change_type")
  quantityChange Decimal  @map("quantity_change") @db.Decimal(10, 2)
  reason         String?
  createdBy      Int?     @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  inventory Inventory @relation(fields: [inventoryId], references: [id])

  @@map("inventory_logs")
}

model Customer {
  id          Int      @id @default(autoincrement())
  farmId      Int      @map("farm_id")
  name        String
  phone       String?
  email       String?
  address     String?
  totalCredit Decimal  @default(0) @map("total_credit") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  farm     Farm      @relation(fields: [farmId], references: [id])
  sales    Sale[]
  credits  Credit[]
  invoices Invoice[]
  quotes   Quote[]

  @@map("customers")
}

model Sale {
  id            Int      @id @default(autoincrement())
  farmId        Int      @map("farm_id")
  customerId    Int?     @map("customer_id")
  items         Json
  totalAmount   Decimal  @map("total_amount") @db.Decimal(12, 2)
  paymentStatus String   @default("paid") @map("payment_status")
  amountPaid    Decimal  @default(0) @map("amount_paid") @db.Decimal(12, 2)
  saleDate      DateTime @default(now()) @map("sale_date")
  createdBy     Int?     @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  farm     Farm      @relation(fields: [farmId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  user     User?     @relation(fields: [createdBy], references: [id])
  credits  Credit[]
  invoices Invoice[]

  @@map("sales")
}

model Credit {
  id         Int       @id @default(autoincrement())
  saleId     Int?      @map("sale_id")
  customerId Int       @map("customer_id")
  farmId     Int       @map("farm_id")
  amountOwed Decimal   @map("amount_owed") @db.Decimal(12, 2)
  amountPaid Decimal   @default(0) @map("amount_paid") @db.Decimal(12, 2)
  dueDate    DateTime? @map("due_date")
  status     String    @default("pending")
  createdAt  DateTime  @default(now()) @map("created_at")

  sale     Sale?    @relation(fields: [saleId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  farm     Farm     @relation(fields: [farmId], references: [id])

  @@map("credits")
}

model Invoice {
  id            Int       @id @default(autoincrement())
  farmId        Int       @map("farm_id")
  saleId        Int?      @map("sale_id")
  customerId    Int?      @map("customer_id")
  invoiceNumber String    @map("invoice_number")
  items         Json
  totalAmount   Decimal   @map("total_amount") @db.Decimal(12, 2)
  amountPaid    Decimal   @default(0) @map("amount_paid") @db.Decimal(12, 2)
  paymentStatus String    @default("pending") @map("payment_status")
  dueDate       DateTime? @map("due_date")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  farm     Farm      @relation(fields: [farmId], references: [id])
  sale     Sale?     @relation(fields: [saleId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@map("invoices")
}

model Quote {
  id            Int       @id @default(autoincrement())
  farmId        Int       @map("farm_id")
  customerId    Int?      @map("customer_id")
  quoteNumber   String    @map("quote_number")
  items         Json
  totalAmount   Decimal   @map("total_amount") @db.Decimal(12, 2)
  status        String    @default("draft") // draft | sent | accepted | declined | expired | converted
  validUntil    DateTime? @map("valid_until")
  notes         String?
  sentAt        DateTime? @map("sent_at")
  respondedAt   DateTime? @map("responded_at")
  convertedInvoiceId Int? @map("converted_invoice_id")
  // Public, unguessable token for customer-facing accept/decline links (/q/<token>)
  responseToken String?   @unique @map("response_token")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  farm      Farm      @relation(fields: [farmId], references: [id])
  customer  Customer? @relation(fields: [customerId], references: [id])

  @@index([farmId, status])
  @@map("quotes")
}

model Worker {
  id           Int       @id @default(autoincrement())
  farmId       Int       @map("farm_id")
  name         String
  phone        String?
  role         String?
  pin          String?
  tokenVersion Int       @default(0) @map("token_version")
  dailyWage    Decimal?  @map("daily_wage") @db.Decimal(10, 2)
  status       String    @default("active")
  hiredDate    DateTime? @map("hired_date")
  createdBy    Int?      @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")

  farm       Farm         @relation(fields: [farmId], references: [id])
  creator    User?        @relation(fields: [createdBy], references: [id])
  attendance Attendance[]
  zktecoLogs ZKTecoLog[]
  tasks      WorkerTask[]
  logs       WorkerLog[]

  @@map("workers")
}

model WorkerTask {
  id          Int       @id @default(autoincrement())
  farmId      Int       @map("farm_id")
  workerId    Int?      @map("worker_id")
  title       String
  description String?
  category    String    @default("general") // feed, eggs, milk, health, cleaning, general
  dueDate     DateTime  @default(now()) @map("due_date") @db.Date
  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  farm   Farm    @relation(fields: [farmId], references: [id])
  worker Worker? @relation(fields: [workerId], references: [id])

  @@map("worker_tasks")
}

model WorkerLog {
  id        Int      @id @default(autoincrement())
  farmId    Int      @map("farm_id")
  workerId  Int      @map("worker_id")
  type      String // eggs, milk, feed, mortality, task_done
  quantity  Decimal  @default(0) @db.Decimal(10, 2)
  unit      String? // pieces, litres, kg, count
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  farm   Farm   @relation(fields: [farmId], references: [id])
  worker Worker @relation(fields: [workerId], references: [id])

  @@map("worker_logs")
}

model Attendance {
  id        Int      @id @default(autoincrement())
  workerId  Int      @map("worker_id")
  farmId    Int      @map("farm_id")
  date      DateTime @db.Date
  checkIn   String?  @map("check_in")
  checkOut  String?  @map("check_out")
  status    String   @default("present")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  worker Worker @relation(fields: [workerId], references: [id])
  farm   Farm   @relation(fields: [farmId], references: [id])

  @@map("attendance")
}

model FeedRecipe {
  id          Int      @id @default(autoincrement())
  farmId      Int      @map("farm_id")
  name        String
  ingredients Json?
  costPerBag  Decimal? @map("cost_per_bag") @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  farm Farm @relation(fields: [farmId], references: [id])

  @@map("feed_recipes")
}

model WeatherCache {
  id           Int      @id @default(autoincrement())
  farmId       Int?     @map("farm_id")
  location     String   @default("default")
  date         DateTime @db.Date
  tempMax      Decimal? @map("temperature_max") @db.Decimal(5, 2)
  tempMin      Decimal? @map("temperature_min") @db.Decimal(5, 2)
  rainfallMm   Decimal? @map("rainfall_mm") @db.Decimal(5, 2)
  weatherCode  String?  @map("weather_code")
  forecastJson Json?    @map("forecast_json")
  createdAt    DateTime @default(now()) @map("created_at")

  farm Farm? @relation(fields: [farmId], references: [id])

  @@unique([location, date])
  @@map("weather_cache")
}

model FarmSetting {
  id           Int      @id @default(autoincrement())
  farmId       Int      @map("farm_id")
  settingKey   String   @map("setting_key")
  settingValue String?  @map("setting_value")
  updatedAt    DateTime @updatedAt @map("updated_at")

  farm Farm @relation(fields: [farmId], references: [id])

  @@unique([farmId, settingKey])
  @@map("farm_settings")
}

model ZKTecoDevice {
  id           Int       @id @default(autoincrement())
  farmId       Int       @map("farm_id")
  serialNumber String    @map("serial_number")
  deviceSecret String    @map("device_secret") // shared secret required in push payload — prevents forged attendance
  name         String?
  model        String?
  status       String    @default("active") // active, inactive
  lastSyncAt   DateTime? @map("last_sync_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  farm Farm        @relation(fields: [farmId], references: [id])
  logs ZKTecoLog[]

  @@unique([farmId, serialNumber])
  @@map("zkteco_devices")
}

model ZKTecoLog {
  id           Int      @id @default(autoincrement())
  deviceId     Int      @map("device_id")
  farmId       Int      @map("farm_id")
  deviceUserId String   @map("device_user_id") // user ID on the ZKTeco device
  workerId     Int?     @map("worker_id") // mapped Wangari worker ID
  timestamp    DateTime
  verifyType   String?  @map("verify_type") // fingerprint, face, card, password
  attendanceId String?  @map("attendance_id") // unique ID from device to prevent duplicates
  raw          Json?
  createdAt    DateTime @default(now()) @map("created_at")

  device ZKTecoDevice @relation(fields: [deviceId], references: [id])
  farm   Farm         @relation(fields: [farmId], references: [id])
  worker Worker?      @relation(fields: [workerId], references: [id])

  @@unique([deviceId, attendanceId])
  @@map("zkteco_logs")
}

model Ticket {
  id         Int      @id @default(autoincrement())
  subject    String
  status     String   @default("open") // open | pending | solved | closed
  priority   String   @default("normal") // low | normal | high
  userId     Int?     @map("user_id")
  farmId     Int?     @map("farm_id")
  assigneeId Int?     @map("assignee_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user     User?           @relation(fields: [userId], references: [id])
  messages TicketMessage[]

  @@index([status])
  @@map("tickets")
}

model TicketMessage {
  id         Int      @id @default(autoincrement())
  ticketId   Int      @map("ticket_id")
  authorType String   @map("author_type") // user | admin
  authorId   Int?     @map("author_id")
  body       String
  createdAt  DateTime @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_messages")
}

model PromoCode {
  id             String    @id @default(cuid())
  code           String    @unique
  type           String    @default("discount") // discount | partnership | credit | sponsorship
  discountType   String?   @map("discount_type") // percent | fixed
  value          Int? // percent (1-100) or fixed KES
  freeMonths     Int?      @map("free_months") // sponsorship: months of free subscription granted on redemption
  maxRedemptions Int?      @map("max_redemptions")
  timesRedeemed  Int       @default(0) @map("times_redeemed")
  partnerName    String?   @map("partner_name")
  expiresAt      DateTime? @map("expires_at")
  active         Boolean   @default(true)
  createdBy      Int?      @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")

  redemptions PromoRedemption[]

  @@map("promo_codes")
}

model PromoRedemption {
  id          Int      @id @default(autoincrement())
  promoCodeId String   @map("promo_code_id")
  userId      Int      @map("user_id")
  reference   String? // paystack reference when tied to a payment
  discountKes Decimal  @default(0) @map("discount_kes") @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id])

  @@index([promoCodeId])
  @@map("promo_redemptions")
}

model Announcement {
  id        Int      @id @default(autoincrement())
  message   String
  link      String?
  active    Boolean  @default(true)
  // Null = global (waadmin broadcasts). Set = notification for one farm only
  // (e.g. "customer accepted your quote QTE-…").
  farmId    Int?     @map("farm_id")
  createdAt DateTime @default(now()) @map("created_at")

  farm Farm? @relation(fields: [farmId], references: [id])

  @@index([farmId, active])
  @@map("announcements")
}

model CrmContact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  company   String? // farm / organization
  type      String   @default("lead") // lead | partner | customer
  stage     String   @default("lead") // lead | contacted | demo | trial | customer | churned
  source    String? // contact_form | manual | referral
  ownerId   Int?     @map("owner_id") // admin responsible
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  notes CrmContactNote[]

  @@index([stage])
  @@map("crm_contacts")
}

model CrmContactNote {
  id        Int      @id @default(autoincrement())
  contactId Int      @map("contact_id")
  body      String
  authorId  Int?     @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")

  contact CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@map("crm_contact_notes")
}

model EmailLog {
  id         Int      @id @default(autoincrement())
  to         String
  subject    String
  template   String? // receipt | ticket_reply | announcement | oneoff
  status     String   @default("queued") // queued | sent | failed
  provider   String?
  providerId String?  @map("provider_id")
  error      String?
  userId     Int?     @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([status])
  @@map("email_logs")
}

model NewsArticle {
  id         Int      @id @default(autoincrement())
  linkHash   String   @unique @map("link_hash") // sha1 of the canonical article URL — the dedupe key
  source     String // "Kilimo News" | "FarmBiz Africa" | "allAfrica Agriculture" | "Google News — World Farming"
  title      String
  link       String
  region     String   @default("kenya") // kenya | world
  risk       String? // ALERT label when the headline matches a farmer-risk keyword
  publishedAt DateTime? @map("published_at")
  firstSentAt DateTime? @map("first_sent_at") // set once the article has appeared in any advisory email
  createdAt  DateTime @default(now()) @map("created_at")

  sends      NewsArticleSend[]

  @@index([region, firstSentAt])
  @@map("news_articles")
}

// Per-farm record that a farmer has already received this story. Advisory
// emails only include rows where no send exists for that farm — a farmer who
// has been told a story never gets it again, even months later.
model NewsArticleSend {
  id           Int      @id @default(autoincrement())
  articleId    Int      @map("article_id")
  farmId       Int      @map("farm_id")
  sentAt       DateTime @default(now()) @map("sent_at")

  article NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  farm    Farm        @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@unique([articleId, farmId])
  @@index([farmId, sentAt])
  @@map("news_article_sends")
}

model SyncedWrite {
  id           Int       @id @default(autoincrement())
  clientId     String    @unique @map("client_id") // idempotency key from the offline queue
  responseBody String    @map("response_body") // stored JSON response, replayed on duplicate
  statusCode   Int       @default(500) @map("status_code") // 500 = in-flight marker
  userId       Int?      @map("user_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("synced_writes")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  farmId     Int?     @map("farm_id")
  action     String
  entityType String?  @map("entity_type")
  entityId   Int?     @map("entity_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])
  farm Farm? @relation(fields: [farmId], references: [id])

  @@map("audit_log")
}
